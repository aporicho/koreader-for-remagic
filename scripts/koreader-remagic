#!/bin/sh
set -eu

KOREADER_DIR=${KOREADER_DIR:-/home/root/apps/koreader}
QTFB_SHIM=${QTFB_SHIM:-/home/root/apps/remagic/shims/qtfb-shim.so}
KOREADER_READER=${KOREADER_READER:-$KOREADER_DIR/reader.lua}
KOREADER_DATA_DIR=${KOREADER_DATA_DIR:-${KO_HOME:-/home/root/.local/share/remagic-koreader/data}}
KOREADER_LIBRARY_DIR=${KOREADER_LIBRARY_DIR:-/home/root/.local/share/remagic-koreader/library}
KOREADER_SETTINGS=${KOREADER_SETTINGS:-$KOREADER_DATA_DIR/settings.reader.lua}
KOREADER_MIGRATOR=${KOREADER_MIGRATOR:-/home/root/apps/remagic-koreader/libexec/koreader-data-migrate}
KOREADER_LIBRARY_SYNC=${KOREADER_LIBRARY_SYNC:-/home/root/apps/remagic-koreader/libexec/koreader-library-sync}
KOREADER_LIFECYCLE_HELPER=${KOREADER_LIFECYCLE_HELPER:-/home/root/apps/remagic-koreader/libexec/koreader-lifecycle}
KOREADER_ASYNC_MODULE=${KOREADER_ASYNC_MODULE:-${KOREADER_LIFECYCLE_HELPER%/*}/remagic-lifecycle-async.lua}
KOREADER_PROTOCOL_MODULE=${KOREADER_PROTOCOL_MODULE:-${KOREADER_LIFECYCLE_HELPER%/*}/remagic-lifecycle-protocol.lua}
KOREADER_OPEN_PATH_MODULE=${KOREADER_OPEN_PATH_MODULE:-${KOREADER_LIFECYCLE_HELPER%/*}/remagic-open-path.lua}
KOREADER_PLATFORM_PATCH_DIR=${KOREADER_PLATFORM_PATCH_DIR:-/home/root/apps/remagic-koreader/share/patches}
KOREADER_STARTUP_SCRIPT=${KOREADER_STARTUP_SCRIPT:-$KOREADER_DIR/koreader.sh}
KOREADER_ACTIVE_STARTUP_SCRIPT=${KOREADER_ACTIVE_STARTUP_SCRIPT:-/tmp/koreader.sh}
KOREADER_INSTALL_LOCK=${KOREADER_INSTALL_LOCK:-/home/root/apps/.remagic-koreader.install.lock}
KOREADER_INSTALL_FLOCK=${KOREADER_INSTALL_FLOCK:-/usr/bin/flock}

# DataStorage reads KO_HOME while the adapter and migration helpers use
# KOREADER_DATA_DIR.  Accept KO_HOME as the fallback when it is the only
# override, but never allow the two names to point at different trees.
if [ -n "${KO_HOME:-}" ] && [ "$KO_HOME" != "$KOREADER_DATA_DIR" ]; then
    echo "KO_HOME and KOREADER_DATA_DIR must identify the same data root" >&2
    exit 1
fi
KO_HOME=$KOREADER_DATA_DIR

if [ ! -d "$KOREADER_DIR" ]; then
    echo "KOReader directory missing: $KOREADER_DIR" >&2
    exit 1
fi
if [ ! -x "$KOREADER_READER" ]; then
    echo "KOReader reader.lua missing or not executable: $KOREADER_READER" >&2
    exit 1
fi
if [ ! -r "$QTFB_SHIM" ]; then
    echo "Remagic QTFB shim missing: $QTFB_SHIM" >&2
    exit 1
fi
if [ ! -f "$KOREADER_STARTUP_SCRIPT" ] || [ ! -r "$KOREADER_STARTUP_SCRIPT" ]; then
    echo "KOReader startup script missing or unreadable: $KOREADER_STARTUP_SCRIPT" >&2
    exit 1
fi
if [ ! -x "$KOREADER_LIBRARY_SYNC" ]; then
    echo "KOReader friendly library synchronizer missing: $KOREADER_LIBRARY_SYNC" >&2
    exit 1
fi
if [ ! -x "$KOREADER_LIFECYCLE_HELPER" ]; then
    echo "KOReader lifecycle adapter missing: $KOREADER_LIFECYCLE_HELPER" >&2
    exit 1
fi
for lifecycle_module in "$KOREADER_ASYNC_MODULE" "$KOREADER_PROTOCOL_MODULE" "$KOREADER_OPEN_PATH_MODULE"; do
    [ -r "$lifecycle_module" ] || {
        echo "KOReader lifecycle module missing: $lifecycle_module" >&2
        exit 1
    }
done
if [ ! -x "$KOREADER_INSTALL_FLOCK" ]; then
    echo "KOReader deployment lock helper missing: $KOREADER_INSTALL_FLOCK" >&2
    exit 1
fi
for platform_patch in 1-remagic-storage.lua 2-remagic-runtime.lua; do
    if [ ! -r "$KOREADER_PLATFORM_PATCH_DIR/$platform_patch" ]; then
        echo "KOReader platform userpatch missing: $KOREADER_PLATFORM_PATCH_DIR/$platform_patch" >&2
        exit 1
    fi
done

export HOME="${HOME:-/home/root}"
export KOREADER_DIR
export KOREADER_DATA_DIR
# Upstream KOReader's datastorage module uses KO_HOME as its writable data
# root while continuing to load the program and assets from KOREADER_DIR.
# Production defaults remain byte-for-byte compatible; acceptance tests use
# this boundary to keep settings and databases away from real reading data.
export KO_HOME
export STARDICT_DATA_DIR="${STARDICT_DATA_DIR:-$KOREADER_DATA_DIR/data/dict}"
export REMAGIC_APP_ID="${REMAGIC_APP_ID:-koreader}"
export REMAGIC_KOREADER_LIFECYCLE_HELPER="$KOREADER_LIFECYCLE_HELPER"
export REMAGIC_KOREADER_FLOCK="${REMAGIC_KOREADER_FLOCK:-$KOREADER_INSTALL_FLOCK}"
export REMAGIC_KOREADER_ASYNC_MODULE="$KOREADER_ASYNC_MODULE"
export REMAGIC_KOREADER_PROTOCOL_MODULE="$KOREADER_PROTOCOL_MODULE"
export REMAGIC_KOREADER_OPEN_PATH_MODULE="$KOREADER_OPEN_PATH_MODULE"
export REMAGIC_ALLOWED_OPEN_ROOTS="${REMAGIC_ALLOWED_OPEN_ROOTS:-${KOREADER_ALLOWED_OPEN_ROOTS:-/home/root/.local/share/remagic-koreader/library:/home/root/books:/home/root/koreader:/home/root/.local/share/remarkable/xochitl}}"
# The manager knows the wrapper PID only after fork.  The shebang keeps this
# shell in that same process, so bind KOReader's userpatch markers here before
# reader.lua is spawned.
export REMAGIC_APP_PID="$$"

acquire_deployment_read_lock() {
    case "$KOREADER_INSTALL_LOCK" in
        /*) ;;
        *) echo "KOReader deployment lock path must be absolute: $KOREADER_INSTALL_LOCK" >&2; return 1 ;;
    esac
    lock_parent=${KOREADER_INSTALL_LOCK%/*}
    [ -d "$lock_parent" ] && [ ! -L "$lock_parent" ] || {
        echo "KOReader deployment lock parent is unsafe: $lock_parent" >&2
        return 1
    }
    [ ! -L "$KOREADER_INSTALL_LOCK" ] || {
        echo "KOReader deployment lock must not be a symlink: $KOREADER_INSTALL_LOCK" >&2
        return 1
    }
    if [ -e "$KOREADER_INSTALL_LOCK" ] && [ ! -f "$KOREADER_INSTALL_LOCK" ]; then
        echo "KOReader deployment lock is not a regular file: $KOREADER_INSTALL_LOCK" >&2
        return 1
    fi

    previous_umask=$(umask)
    umask 077
    # The lifecycle descriptor can legitimately be any inherited FD. Use the
    # other high POSIX descriptor so acquiring the lock never closes it.
    if [ "${REMAGIC_LIFECYCLE_FD:-}" = 9 ]; then
        exec 8>>"$KOREADER_INSTALL_LOCK"
        deployment_lock_fd=8
    else
        exec 9>>"$KOREADER_INSTALL_LOCK"
        deployment_lock_fd=9
    fi
    umask "$previous_umask"
    chmod 0600 "$KOREADER_INSTALL_LOCK"
    "$KOREADER_INSTALL_FLOCK" -s -n "$deployment_lock_fd" || {
        echo "KOReader deployment is in progress; refusing to launch" >&2
        return 1
    }
    export REMAGIC_KOREADER_DEPLOYMENT_LOCK_FD=$deployment_lock_fd
}

# The standalone installer holds this same inode exclusively for its complete
# transaction. Holding a shared lock for the wrapper lifetime closes the race
# between a process-table check and a concurrent Manager launch.
acquire_deployment_read_lock

cleanup_lifecycle() {
    "$KOREADER_LIFECYCLE_HELPER" cleanup >/dev/null 2>&1 || true
}

# KOReader loads userpatches from DataStorage:getDataDir()/patches, not from
# the immutable program tree when KO_HOME is redirected. Keep the authoritative
# platform patch in the adapter and atomically mirror it into the active data
# root before reader.lua starts. This is required both for ordinary launches
# and for isolated device acceptance, where touching real reading data is
# forbidden.
sync_one_platform_patch() (
    patch_source=$1
    patch_target=$2
    patch_dir=${patch_target%/*}
    if [ -f "$patch_target" ] && cmp -s "$patch_source" "$patch_target"; then
        exit 0
    fi

    umask 077
    patch_tmp=$(mktemp "$patch_dir/.2-remagic-runtime.XXXXXX") || {
        echo "Could not stage KOReader lifecycle userpatch in $patch_dir" >&2
        exit 1
    }
    cleanup_patch_tmp() {
        [ -z "${patch_tmp:-}" ] || rm -f "$patch_tmp"
    }
    trap cleanup_patch_tmp EXIT
    trap 'exit 129' HUP
    trap 'exit 130' INT
    trap 'exit 143' TERM

    cp "$patch_source" "$patch_tmp"
    chmod 0644 "$patch_tmp"
    cmp -s "$patch_source" "$patch_tmp" || {
        echo "KOReader platform userpatch verification failed" >&2
        exit 1
    }
    mv -f "$patch_tmp" "$patch_target"
    patch_tmp=
)

sync_platform_patches() {
    patch_dir=$KOREADER_DATA_DIR/patches
    if [ -L "$patch_dir" ]; then
        echo "KOReader patch directory must not be a symlink: $patch_dir" >&2
        return 1
    fi
    mkdir -p "$patch_dir"
    for platform_patch in 1-remagic-storage.lua 2-remagic-runtime.lua; do
        sync_one_platform_patch \
            "$KOREADER_PLATFORM_PATCH_DIR/$platform_patch" \
            "$patch_dir/$platform_patch"
    done
}

sync_platform_patches
trap cleanup_lifecycle EXIT

# A missing/empty statistics database is the broken partial-migration case seen
# on device. Repair it before reader.lua opens it, without adding validation
# latency to healthy launches. Full validation also runs from install-device.sh.
if [ ! -s "$KOREADER_DATA_DIR/settings/statistics.sqlite3" ] && [ -x "$KOREADER_MIGRATOR" ]; then
    if "$KOREADER_MIGRATOR"; then
        :
    else
        migration_status=$?
        echo "KOReader data repair failed (status=$migration_status); refusing to open an incomplete data directory" >&2
        exit "$migration_status"
    fi
fi

# The reMarkable backend compares /tmp/koreader.sh with the installed script
# and asks for a complete restart when they differ. Normally upstream
# koreader.sh refreshes that copy before it starts reader.lua; this wrapper
# deliberately bypasses that script because its framebuffer setup is unsafe in
# the QTFB host. Reproduce only the harmless relocalization step here.
#
# Build the copy beside its destination and rename it into place so reader.lua
# can never observe a partial script. This also replaces an existing symlink
# instead of following it while running as root.
sync_startup_script() (
    startup_dir=${KOREADER_ACTIVE_STARTUP_SCRIPT%/*}
    if [ "$startup_dir" = "$KOREADER_ACTIVE_STARTUP_SCRIPT" ]; then
        startup_dir=.
    fi
    if [ ! -d "$startup_dir" ]; then
        echo "KOReader active startup directory missing: $startup_dir" >&2
        exit 1
    fi

    umask 077
    startup_tmp=$(mktemp "$startup_dir/.koreader-remagic.XXXXXX") || {
        echo "Could not create temporary KOReader startup script in $startup_dir" >&2
        exit 1
    }
    # This handler is invoked indirectly by the EXIT trap below.
    # shellcheck disable=SC2329
    cleanup_startup_tmp() {
        if [ -n "${startup_tmp:-}" ]; then
            rm -f "$startup_tmp"
        fi
    }
    trap cleanup_startup_tmp EXIT
    trap 'exit 129' HUP
    trap 'exit 130' INT
    trap 'exit 143' TERM

    cp "$KOREADER_STARTUP_SCRIPT" "$startup_tmp"
    chmod 0755 "$startup_tmp"
    if ! cmp -s "$KOREADER_STARTUP_SCRIPT" "$startup_tmp"; then
        echo "KOReader startup script copy verification failed" >&2
        exit 1
    fi
    mv -f "$startup_tmp" "$KOREADER_ACTIVE_STARTUP_SCRIPT"
    startup_tmp=
)

sync_startup_script

if "$KOREADER_LIBRARY_SYNC"; then
    :
else
    library_sync_status=$?
    if [ ! -d "$KOREADER_LIBRARY_DIR" ]; then
        echo "KOReader friendly library synchronization failed (status=$library_sync_status) and no previous view is available" >&2
        exit "$library_sync_status"
    fi
    echo "KOReader friendly library synchronization failed (status=$library_sync_status); using the previous complete view" >&2
fi

select_library_dir() {
    lastdir=
    if [ -r "$KOREADER_SETTINGS" ]; then
        lastdir=$(sed -n \
            's/^[[:space:]]*\["lastdir"\][[:space:]]*=[[:space:]]*"\([^"]*\)"[[:space:]]*,[[:space:]]*$/\1/p' \
            "$KOREADER_SETTINGS" | sed -n '$p')
    fi

    # Only restore directories inside the generated friendly library. This
    # prevents UUID files and .thumbnails from the xochitl store leaking into
    # KOReader's file manager.
    if [ -n "$lastdir" ] && [ -d "$lastdir" ]; then
        case "$lastdir/" in
            "$KOREADER_LIBRARY_DIR/"|"$KOREADER_LIBRARY_DIR/"*)
                echo "koreader-remagic: library_dir=$lastdir source=lastdir" >&2
                printf '%s\n' "$lastdir"
                return
                ;;
        esac
    fi

    if [ -d "$KOREADER_LIBRARY_DIR" ]; then
        echo "koreader-remagic: library_dir=$KOREADER_LIBRARY_DIR source=fallback" >&2
        printf '%s\n' "$KOREADER_LIBRARY_DIR"
        return
    fi

    echo "KOReader friendly library is unavailable: $KOREADER_LIBRARY_DIR" >&2
    return 1
}

# Passing a directory explicitly forces KOReader into its file manager. With
# no argument reader.lua may restore lastfile (including a thumbnail) or a
# broad parent directory instead of the books library.
if [ "$#" -gt 0 ]; then
    # The manager also carries this value in lifecycle Start. The late
    # userpatch uses this exact byte string to avoid opening the same book a
    # second time after reader.lua already consumed argv.
    export REMAGIC_INITIAL_OPEN_PATH=$1
fi
if [ "$#" -eq 0 ]; then
    set -- "$(select_library_dir)"
fi

child_pid=

terminate_child() {
    signal=$1
    status=$2
    # The manager sends TERM one second before it escalates to KILL. Stop
    # handling signals recursively, give reader.lua half of that remaining
    # budget, then kill and reap it ourselves. Otherwise the manager can only
    # kill this wrapper PID and a wedged reader.lua would survive as an orphan.
    trap - HUP INT TERM
    if [ -n "$child_pid" ]; then
        kill -"$signal" "$child_pid" 2>/dev/null || true

        (
            sleep 0.5
            kill -KILL "$child_pid" 2>/dev/null || true
        ) &
        child_killer_pid=$!

        wait "$child_pid" 2>/dev/null || true
        kill -TERM "$child_killer_pid" 2>/dev/null || true
        wait "$child_killer_pid" 2>/dev/null || true
        child_pid=
    fi
    exit "$status"
}

trap 'terminate_child TERM 143' TERM
trap 'terminate_child INT 130' INT
trap 'terminate_child HUP 129' HUP

cd "$KOREADER_DIR" || exit 1

# Run reader.lua directly: the upstream koreader.sh probes fbdepth/fbink and
# /dev/fb0 before starting KOReader, none of which belongs in the QTFB host.
# Keep LD_PRELOAD on the reader process only so shell helpers and the manager
# itself are never shimmed.
while :; do
    LD_PRELOAD="$QTFB_SHIM" \
    QTFB_SHIM_ONESHOT=1 \
    QTFB_SHIM_MODEL=false \
    QTFB_SHIM_INPUT=1 \
    QTFB_SHIM_INPUT_MODE=NATIVE \
    QTFB_SHIM_MODE=N_RGB565 \
    QTFB_SHIM_RESPECT_APP_REFRESH_MODES=1 \
    QTFB_SHIM_RESPECT_FULL_REFRESH_REQUESTS=1 \
    KO_DONT_GRAB_INPUT=1 \
    KO_DONT_SET_DEPTH=1 \
        "$KOREADER_READER" "$@" &
    child_pid=$!

    if wait "$child_pid"; then
        status=0
    else
        status=$?
    fi
    child_pid=

    # 85 is KOReader's intentional "restart application" result. Every other
    # status, including a clean 0, belongs to the manager unchanged.
    if [ "$status" -ne 85 ]; then
        exit "$status"
    fi
done
