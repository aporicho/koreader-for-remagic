#!/bin/sh
set -eu

# KOReader-side transport adapter for Remagic lifecycle protocol v2.
#
# Preferred transport:
#   REMAGIC_LIFECYCLE_FD  - inherited, bidirectional newline-JSON descriptor.
# The Lua userpatch consumes that descriptor directly so the hot path does not
# fork. This helper is used for REMAGIC_APP_BRIDGE and for the schema-v1 marker
# fallback. A platform bridge must implement:
#
#   $REMAGIC_APP_BRIDGE emit   # read one v2 envelope from stdin
#   $REMAGIC_APP_BRIDGE poll   # write zero or more v2 envelopes to stdout

RUNTIME_DIR=${REMAGIC_RUNTIME_DIR:-/run/remagic}
APP_ID=${REMAGIC_APP_ID:-koreader}
APP_PID=${REMAGIC_APP_PID:-}
APP_GENERATION=${REMAGIC_APP_GENERATION:-}
READY_PATH=$RUNTIME_DIR/koreader-ready
EXIT_PATH=$RUNTIME_DIR/koreader-exit

die() {
    echo "koreader-lifecycle: $*" >&2
    exit 2
}

is_decimal() {
    case ${1-} in
        ''|*[!0-9]*) return 1 ;;
        *) return 0 ;;
    esac
}

valid_identity() {
    [ "$APP_ID" = koreader ] && is_decimal "$APP_PID" && is_decimal "$APP_GENERATION"
}

identity() {
    printf 'pid=%s\ngeneration=%s\n' "$APP_PID" "$APP_GENERATION"
}

read_envelope() {
    IFS= read -r envelope || die 'emit requires one newline-terminated JSON envelope on stdin'
    [ -n "$envelope" ] || die 'empty lifecycle envelope'
    if IFS= read -r trailing; then
        die 'emit accepts exactly one lifecycle envelope'
    fi
    printf '%s\n' "$envelope"
}

event_from_envelope() {
    # Envelopes are generated by dkjson. Only the event discriminator is
    # inspected here; all semantic validation remains in the platform.
    printf '%s\n' "$1" | sed -n \
        's/.*"event"[[:space:]]*:[[:space:]]*"\([a-z_]*\)".*/\1/p'
}

atomic_legacy_ready() {
    valid_identity || return 1
    [ -d "$RUNTIME_DIR" ] || return 1
    umask 077
    ready_tmp=$RUNTIME_DIR/.koreader-ready.$APP_PID.$APP_GENERATION.$$.tmp
    trap 'rm -f "${ready_tmp:-}"' EXIT HUP INT TERM
    identity >"$ready_tmp"
    mv -f "$ready_tmp" "$READY_PATH"
    ready_tmp=
    trap - EXIT HUP INT TERM
}

remove_owned_marker() {
    path=$1
    [ -f "$path" ] || return 0
    expected=$(identity)
    actual=$(cat "$path" 2>/dev/null || true)
    [ "$actual" = "$expected" ] && rm -f "$path"
    return 0
}

emit() {
    envelope=$(read_envelope)
    event=$(event_from_envelope "$envelope")

    if [ -n "${REMAGIC_APP_BRIDGE:-}" ] && [ -x "$REMAGIC_APP_BRIDGE" ]; then
        if printf '%s\n' "$envelope" | "$REMAGIC_APP_BRIDGE" emit; then
            exit 0
        fi
        echo 'koreader-lifecycle: v2 bridge emit failed; attempting legacy fallback' >&2
    elif is_decimal "${REMAGIC_LIFECYCLE_FD:-}"; then
        # This path is mainly useful to shell callers. The Lua patch writes the
        # same inherited FD directly and avoids spawning this helper.
        if eval "printf '%s\\n' \"\$envelope\" >&${REMAGIC_LIFECYCLE_FD}" 2>/dev/null; then
            exit 0
        fi
        echo 'koreader-lifecycle: inherited lifecycle FD emit failed; attempting legacy fallback' >&2
    fi

    case $event in
        ready)
            atomic_legacy_ready
            ;;
        shutdown_complete)
            valid_identity || exit 0
            remove_owned_marker "$EXIT_PATH"
            remove_owned_marker "$READY_PATH"
            ;;
        # Schema-v1 has no acknowledgement channel for these events. Treat
        # them as successfully downgraded rather than making KOReader retry.
        background_ready|state_saved|failed|foreground_ready)
            ;;
        *)
            die "unsupported lifecycle event: ${event:-missing}"
            ;;
    esac
}

poll() {
    if [ -n "${REMAGIC_APP_BRIDGE:-}" ] && [ -x "$REMAGIC_APP_BRIDGE" ]; then
        exec "$REMAGIC_APP_BRIDGE" poll
    fi

    # Direct-FD commands are consumed in-process by the Lua patch. With no v2
    # bridge, adapt the old identity-bound exit marker into one v2 command.
    valid_identity || exit 0
    [ -r "$EXIT_PATH" ] || exit 0
    expected=$(identity)
    actual=$(cat "$EXIT_PATH" 2>/dev/null || true)
    [ "$actual" = "$expected" ] || exit 0
    printf '{"protocol":2,"request_id":"legacy-koreader-%s-%s-shutdown","body":{"command":"shutdown","app_id":"koreader","generation":%s,"legacy":true}}\n' \
        "$APP_PID" "$APP_GENERATION" "$APP_GENERATION"
}

consume_legacy_shutdown() {
    valid_identity || exit 0
    remove_owned_marker "$EXIT_PATH"
}

cleanup() {
    valid_identity || exit 0
    remove_owned_marker "$EXIT_PATH"
    remove_owned_marker "$READY_PATH"
}

case ${1-} in
    emit) emit ;;
    poll) poll ;;
    consume-legacy-shutdown) consume_legacy_shutdown ;;
    cleanup) cleanup ;;
    *) die 'usage: koreader-lifecycle {emit|poll|consume-legacy-shutdown|cleanup}' ;;
esac
